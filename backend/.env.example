## BACKEND DEVELOPMENT .env

NODE_ENV=development
PUBLIC_URL=http://localhost:5173
PORT=4321
SESSION_SECRET=change-me

# GOOGLE OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_CALLBACK_URI=http://localhost:4321/auth/google/callback

# MONGODB (unchanged Atlas / existing cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DB?retryWrites=true
