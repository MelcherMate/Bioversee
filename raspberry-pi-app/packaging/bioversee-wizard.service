[Unit]
Description=Bioversee Raspberry Pi setup wizard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/bioversee-pi
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/bioversee/pi.env
ExecStart=/opt/bioversee-pi/.venv/bin/bioversee-wizard
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
