#!/usr/bin/env bash
# Bioversee Pi Setup — GUI installer (cloud preconfigured).
# Prefer launching via "Install Bioversee.desktop" (double-click in Downloads).
# Or: curl -fsSL https://YOUR_SITE/downloads/bioversee-pi-setup.sh | bash

set -euo pipefail

BIOVERSEE_SUPABASE_URL="@@BIOVERSEE_SUPABASE_URL@@"
BIOVERSEE_SUPABASE_ANON_KEY="@@BIOVERSEE_SUPABASE_ANON_KEY@@"
BIOVERSEE_UPDATE_REPO="${BIOVERSEE_UPDATE_REPO:-MelcherMate/Bioversee}"
BIOVERSEE_UPDATE_BRANCH="${BIOVERSEE_UPDATE_BRANCH:-master}"
BIOVERSEE_UPDATE_SUBDIR="${BIOVERSEE_UPDATE_SUBDIR:-raspberry-pi-app}"
PREFIX="${BIOVERSEE_PREFIX:-/opt/bioversee-pi}"
SETUP_VERSION="@@BIOVERSEE_SETUP_VERSION@@"
SETUP_SH_URL="@@BIOVERSEE_SETUP_SH_URL@@"

TITLE="Bioversee Setup"

die() {
  local msg="$1"
  if [[ -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --error --title="$TITLE" --width=420 --text="$msg" || true
  fi
  echo "$msg" >&2
  exit 1
}

info() {
  if [[ -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    zenity --info --title="$TITLE" --width=420 --text="$1" || true
  else
    echo "$1"
  fi
}

if [[ -z "${BIOVERSEE_SUPABASE_URL}" || -z "${BIOVERSEE_SUPABASE_ANON_KEY}" ]] \
  || [[ "${BIOVERSEE_SUPABASE_URL}" == @@* ]] \
  || [[ "${BIOVERSEE_SUPABASE_ANON_KEY}" == @@* ]]; then
  die "Setup was built without cloud credentials. Open bioversee.com and try again."
fi

if [[ "$(uname -s)" != "Linux" ]]; then
  die "Run this installer on your Raspberry Pi."
fi

# --- GUI confirm (non-root) ---
if [[ "$(id -u)" -ne 0 ]]; then
  if [[ -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
    if ! zenity --question --title="$TITLE" --width=420 \
      --ok-label="Install" --cancel-label="Cancel" \
      --text="Install Bioversee on this Raspberry Pi?\n\nVersion ${SETUP_VERSION}\nConnects to Bioversee cloud automatically."; then
      exit 0
    fi
  fi

  # Elevate with a password dialog (like Windows UAC), then re-run this script
  export BIOVERSEE_SUPABASE_URL BIOVERSEE_SUPABASE_ANON_KEY
  export BIOVERSEE_UPDATE_REPO BIOVERSEE_UPDATE_BRANCH BIOVERSEE_UPDATE_SUBDIR
  export BIOVERSEE_PREFIX="${PREFIX}"
  export SETUP_SH_URL

  if command -v pkexec >/dev/null 2>&1; then
    if [[ -n "${SETUP_SH_URL}" && "${SETUP_SH_URL}" != @@* ]]; then
      exec pkexec env \
        DISPLAY="${DISPLAY:-}" \
        XAUTHORITY="${XAUTHORITY:-}" \
        BIOVERSEE_SUPABASE_URL="${BIOVERSEE_SUPABASE_URL}" \
        BIOVERSEE_SUPABASE_ANON_KEY="${BIOVERSEE_SUPABASE_ANON_KEY}" \
        BIOVERSEE_UPDATE_REPO="${BIOVERSEE_UPDATE_REPO}" \
        BIOVERSEE_UPDATE_BRANCH="${BIOVERSEE_UPDATE_BRANCH}" \
        BIOVERSEE_UPDATE_SUBDIR="${BIOVERSEE_UPDATE_SUBDIR}" \
        BIOVERSEE_PREFIX="${PREFIX}" \
        bash -c "curl -fsSL '${SETUP_SH_URL}' | bash"
    fi
  fi

  exec sudo -E env \
    BIOVERSEE_SUPABASE_URL="${BIOVERSEE_SUPABASE_URL}" \
    BIOVERSEE_SUPABASE_ANON_KEY="${BIOVERSEE_SUPABASE_ANON_KEY}" \
    BIOVERSEE_UPDATE_REPO="${BIOVERSEE_UPDATE_REPO}" \
    BIOVERSEE_UPDATE_BRANCH="${BIOVERSEE_UPDATE_BRANCH}" \
    BIOVERSEE_UPDATE_SUBDIR="${BIOVERSEE_UPDATE_SUBDIR}" \
    BIOVERSEE_PREFIX="${PREFIX}" \
    bash -c "curl -fsSL '${SETUP_SH_URL}' | bash"
fi

# --- root install ---
export BIOVERSEE_SUPABASE_URL BIOVERSEE_SUPABASE_ANON_KEY
export BIOVERSEE_PREFIX="${PREFIX}"

run_install() {
  echo "==> Bioversee Pi Setup ${SETUP_VERSION}"
  TMP="$(mktemp -d /tmp/bioversee-setup.XXXXXX)"
  cleanup() { rm -rf "${TMP}"; }
  trap cleanup EXIT

  ZIP_URL="https://github.com/${BIOVERSEE_UPDATE_REPO}/archive/refs/heads/${BIOVERSEE_UPDATE_BRANCH}.zip"
  ZIP_PATH="${TMP}/bioversee.zip"

  echo "==> Downloading…"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "${ZIP_URL}" -o "${ZIP_PATH}"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "${ZIP_PATH}" "${ZIP_URL}"
  else
    die "Need curl or wget."
  fi

  echo "==> Unpacking…"
  if ! command -v unzip >/dev/null 2>&1; then
    apt-get update -y
    apt-get install -y unzip
  fi
  unzip -q "${ZIP_PATH}" -d "${TMP}/extract"

  SOURCE=""
  for dir in "${TMP}/extract"/*; do
    if [[ -d "${dir}/${BIOVERSEE_UPDATE_SUBDIR}" ]]; then
      SOURCE="${dir}/${BIOVERSEE_UPDATE_SUBDIR}"
      break
    fi
  done

  if [[ -z "${SOURCE}" || ! -f "${SOURCE}/packaging/install.sh" ]]; then
    die "Download incomplete — try again."
  fi

  chmod +x "${SOURCE}/packaging/install.sh"
  echo "==> Installing…"
  BIOVERSEE_SUPABASE_URL="${BIOVERSEE_SUPABASE_URL}" \
  BIOVERSEE_SUPABASE_ANON_KEY="${BIOVERSEE_SUPABASE_ANON_KEY}" \
  bash "${SOURCE}/packaging/install.sh"

  mkdir -p /etc/bioversee
  cat > /etc/bioversee/pi.env <<EOF
BIOVERSEE_SUPABASE_URL=${BIOVERSEE_SUPABASE_URL}
BIOVERSEE_SUPABASE_ANON_KEY=${BIOVERSEE_SUPABASE_ANON_KEY}
BIOVERSEE_WIZARD_HOST=127.0.0.1
BIOVERSEE_WIZARD_PORT=8787
EOF
  chmod 600 /etc/bioversee/pi.env

  # Do not start a browser — desktop app is launched after install.
  systemctl disable --now bioversee-wizard.service 2>/dev/null || true
}

if [[ -n "${DISPLAY:-}" ]] && command -v zenity >/dev/null 2>&1; then
  LOG="$(mktemp /tmp/bioversee-setup.XXXXXX.log)"
  (
    echo "10"
    echo "# Installing Bioversee…"
    if run_install >"$LOG" 2>&1; then
      echo "100"
      echo "# Done"
    else
      echo "100"
      echo "# Failed"
      exit 1
    fi
  ) | zenity --progress --title="$TITLE" --width=420 --auto-close --no-cancel \
      --text="Installing Bioversee…" || {
    die "Install failed.\n$(tail -n 15 "$LOG" 2>/dev/null | sed 's/&/\&amp;/g')"
  }
  rm -f "$LOG"
else
  run_install
fi

info "Bioversee is installed on this Pi.\n\nOpening the Bioversee desktop app…"

# Launch the desktop app as the logged-in user (not as root).
APP_BIN="/opt/bioversee-pi/.venv/bin/bioversee"
LAUNCH_USER="${SUDO_USER:-${USER:-}}"
if [[ -x "${APP_BIN}" ]]; then
  if [[ -n "${LAUNCH_USER}" && "${LAUNCH_USER}" != "root" ]]; then
    sudo -u "${LAUNCH_USER}" -E env \
      DISPLAY="${DISPLAY:-}" \
      XAUTHORITY="${XAUTHORITY:-}" \
      WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
      XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u "${LAUNCH_USER}")}" \
      bash -lc "${APP_BIN}" >/tmp/bioversee-app.log 2>&1 &
  else
    "${APP_BIN}" >/tmp/bioversee-app.log 2>&1 &
  fi
elif [[ -f /usr/share/applications/bioversee.desktop ]]; then
  if [[ -n "${LAUNCH_USER}" && "${LAUNCH_USER}" != "root" ]]; then
    sudo -u "${LAUNCH_USER}" -E gtk-launch bioversee >/tmp/bioversee-app.log 2>&1 &
  fi
fi
